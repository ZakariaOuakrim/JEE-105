<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="entity">

    <class name="Personne" table="Personnes">

        <id name="id" column="id_personne">
            <generator class="native"/>
        </id>

        <property name="nom"    column="nom"    not-null="true"/>
        <property name="prenom" column="prenom" not-null="true"/>
        <property name="rue"    column="rue"/>
        <property name="ville"  column="ville"/>


        <many-to-one name="info"
                     class="Info"
                     column="info_id"
                     cascade="all"
                     lazy="false"
                     fetch="join"
                     unique="true"
                     not-null="false"/>

    
        <bag name="activities"
             cascade="all-delete-orphan"
             fetch="subselect"
             lazy="false"
             inverse="true">
            <key column="personne_id"/>
            <one-to-many class="Activity"/>
        </bag>

    </class>

</hibernate-mapping>
